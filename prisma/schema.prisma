generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  phone          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  avatar         String?
  role           String            @default("USER")
  supabaseId     String?           @unique(where: raw("(\"supabaseId\" IS NOT NULL)"))
  bio            String?
  city           String?
  country        String?
  username       String?
  orders         Order[]
  bookOrders     BookOrder[]
  purchasedBooks PurchasedBook[]
  cartItems      ShoppingCartItem[]
}

model Service {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String
  workflow    String?
  examples    String?
  seoId       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  seoMetadata SeoMetadata? @relation(fields: [seoId], references: [id])
}

model PortfolioProject {
  id          String       @id @default(cuid())
  title       String       @unique
  slug        String       @unique
  summary     String
  gallery     String[]
  tags        String[]
  seoId       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  seoMetadata SeoMetadata? @relation(fields: [seoId], references: [id])
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String
  category    String
  seoId       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  seoMetadata SeoMetadata? @relation(fields: [seoId], references: [id])
}

model ToolCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tools     StartupTool[]
}

model StartupTool {
  id            String       @id @default(cuid())
  name          String       @unique
  slug          String       @unique
  thumbnail     String?
  screenshots   String[]
  summary       String
  description   String
  benefits      String[]
  includedFiles String[]
  instructions  String?
  faqs          Json?
  price         Float
  categoryId    String
  seoId         String?      @unique
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orderItems    OrderItem[]
  category      ToolCategory @relation(fields: [categoryId], references: [id])
  seoMetadata   SeoMetadata? @relation(fields: [seoId], references: [id])
}

model Order {
  id         String      @id @default(cuid())
  orderNo    String      @unique
  customerId String
  total      Float
  status     String      @default("PENDING")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  customer   Customer    @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  payment    Payment?
}

model ShoppingCartItem {
  id         String   @id @default(cuid())
  customerId String
  kind       String   @default("TOOL")
  slug       String
  name       String
  category   String
  priceLabel String
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, kind, slug])
  @@index([customerId])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  toolId    String
  price     Float
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  downloads Download[]
  order     Order       @relation(fields: [orderId], references: [id])
  tool      StartupTool @relation(fields: [toolId], references: [id])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  amount      Float
  status      String
  tapChargeId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
}

model Download {
  id          String    @id @default(cuid())
  orderItemId String
  token       String    @unique
  accessedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  status    String   @default("UNREAD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SeoMetadata {
  id               String            @id @default(cuid())
  title            String
  description      String
  ogImage          String?
  slug             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  blogPost         BlogPost?
  portfolioProject PortfolioProject?
  service          Service?
  startupTool      StartupTool?
}

model Book {
  id          String          @id @default(cuid())
  filename    String
  path        String          @unique
  size        Int
  uploadedAt  DateTime        @default(now())
  title       String?
  author      String?
  coverImage  String?
  fileUrl     String?
  /// Free-text age label shown in the UI, e.g. "4-11 years".
  targetAge   String?
  /// Normalized age bucket used for filtering: ALL_AGES | UNDER_6 | AGE_6_10 |
  /// AGE_11_15 | AGE_16_18 | ADULTS. Null means unclassified.
  ageGroup    String?
  category    String?
  summary     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  currency    String          @default("BHD")
  isFree      Boolean         @default(false)
  /// Null for free books; required and > 0 for paid books.
  price       Decimal?
  orders      BookOrder[]
  purchases   PurchasedBook[]
  images      BookImage[]

  @@index([category])
  @@index([ageGroup])
  @@index([isFree])
  @@index([uploadedAt])
}

/// Preview gallery shown on the public book details page.
model BookImage {
  id        String   @id @default(cuid())
  bookId    String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, sortOrder])
}

model PurchasedBook {
  id            String   @id @default(cuid())
  customerId    String
  bookId        String
  price         Decimal
  currency      String
  purchasedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  source        String   @default("PAYMENT")
  status        String   @default("COMPLETED")
  transactionId String?
  orderId       String?  @unique

  customer Customer   @relation(fields: [customerId], references: [id])
  book     Book       @relation(fields: [bookId], references: [id])
  order    BookOrder? @relation(fields: [orderId], references: [id])

  @@unique([customerId, bookId])
  @@index([customerId, status])
  @@index([transactionId])
}

model BookOrder {
  id          String    @id @default(cuid())
  orderNo     String    @unique
  customerId  String
  bookId      String
  amount      Decimal
  currency    String
  status      String    @default("PENDING")
  provider    String    @default("TAP")
  tapChargeId String?   @unique
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  book     Book           @relation(fields: [bookId], references: [id])
  purchase PurchasedBook?

  @@index([customerId, bookId])
  @@index([status])
  @@unique([customerId, bookId], where: raw("(status = 'PENDING')"), name: "BookOrder_pending_customer_book_key")
}

model Website {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  image          String?
  gallery        String[] @default([])
  summary       String?
  description   String?
  system        String?
  details       String?
  features      String?
  targetAudience String?
  responsive    String?
  price         Float
  currency      String
  category      String?
  websiteUrl    String
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  userAgent String?
  createdAt DateTime @default(now())
}
