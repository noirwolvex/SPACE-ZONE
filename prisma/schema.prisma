generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  runtime         = "workerd"
  moduleFormat    = "esm"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Customer {
  id             String            @id @default(cuid())
  email          String            @unique
  name           String?
  phone          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  avatar         String?
  role           String            @default("USER")
  supabaseId     String?           @unique(where: raw("(\"supabaseId\" IS NOT NULL)"))
  bio            String?
  city           String?
  country        String?
  username       String?
  orders         Order[]
  bookOrders     BookOrder[]
  purchasedBooks PurchasedBook[]
  cartItems      ShoppingCartItem[]
  websitePurchases WebsitePurchase[]
}

model Service {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  summary     String
  description String
  workflow    String?
  examples    String?
  bestFor     String?
  seoId       String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  seoMetadata SeoMetadata?  @relation(fields: [seoId], references: [id])
  media       ServiceMedia?
}

model ServiceMedia {
  serviceId String   @id
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model PortfolioProject {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  summary     String
  outcome     String?
  challenge   String?
  solution    String?
  process     String[]     @default([])
  techStack   String[]     @default([])
  industry    String?
  duration    String?
  gallery     String[]
  tags        String[]
  services    String[]     @default([])
  metrics     Json         @default("[]")
  gradient    String       @default("from-indigo-100 via-white to-sky-100")
  seoId       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  seoMetadata SeoMetadata? @relation(fields: [seoId], references: [id])

  @@index([industry])
}

model BlogPost {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String
  category    String
  seoId       String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  seoMetadata SeoMetadata? @relation(fields: [seoId], references: [id])
}

model ToolCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  tools     StartupTool[]
}

model StartupTool {
  id            String           @id @default(cuid())
  name          String           @unique
  slug          String           @unique
  thumbnail     String?
  screenshots   String[]
  summary       String
  description   String
  benefits      String[]
  includedFiles String[]
  bestFor       String[]         @default([])
  instructions  String?
  faqs          Json?
  price         Decimal          @db.Decimal(12, 3)
  categoryId    String
  seoId         String?          @unique
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  orderItems    OrderItem[]
  files         StartupToolFile[]
  category      ToolCategory      @relation(fields: [categoryId], references: [id])
  seoMetadata   SeoMetadata?      @relation(fields: [seoId], references: [id])

  @@index([categoryId])
}

model StartupToolFile {
  id          String        @id @default(cuid())
  toolId      String
  filename    String
  path        String        @unique
  size        Int
  contentType String
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tool        StartupTool   @relation(fields: [toolId], references: [id], onDelete: Cascade)
  downloads   Download[]

  @@index([toolId, sortOrder])
}

model Order {
  id         String        @id @default(cuid())
  orderNo    String        @unique
  customerId String
  total      Decimal       @db.Decimal(12, 3)
  status     String        @default("PENDING")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  customer   Customer      @relation(fields: [customerId], references: [id])
  items      OrderItem[]
  payment    Payment?

  @@index([customerId])
}

model ShoppingCartItem {
  id         String   @id @default(cuid())
  customerId String
  kind       String   @default("TOOL")
  slug       String
  name       String
  category   String
  priceLabel String
  thumbnail  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])

  @@unique([customerId, kind, slug])
  @@index([customerId])
}

model OrderItem {
  id        String      @id @default(cuid())
  orderId   String
  toolId    String
  price     Decimal     @db.Decimal(12, 3)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  downloads Download[]
  order     Order       @relation(fields: [orderId], references: [id])
  tool      StartupTool @relation(fields: [toolId], references: [id])

  @@index([orderId])
  @@index([toolId])
}

model Payment {
  id          String   @id @default(cuid())
  orderId     String   @unique
  amount      Decimal  @db.Decimal(12, 3)
  status      String
  tapChargeId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  order       Order    @relation(fields: [orderId], references: [id])
}

model Download {
  id            String           @id @default(cuid())
  orderItemId   String
  fileId        String?
  token         String           @unique
  accessedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  orderItem     OrderItem        @relation(fields: [orderItemId], references: [id])
  file          StartupToolFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@index([fileId])
}

model ContactMessage {
  id             String   @id @default(cuid())
  name           String
  email          String
  phone          String?
  company        String?
  service        String?
  budget         String?
  timeline       String?
  contactType    String   @default("Inquiry")
  message        String
  details        String?
  attachmentUrl  String?
  attachmentName String?
  status         String   @default("UNREAD")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SeoMetadata {
  id               String            @id @default(cuid())
  title            String
  description      String
  ogImage          String?
  slug             String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  blogPost         BlogPost?
  portfolioProject PortfolioProject?
  service          Service?
  startupTool      StartupTool?
}

model Book {
  id             String          @id @default(cuid())
  filename       String
  path           String          @unique
  size           Int
  uploadedAt     DateTime        @default(now())
  title          String?
  author         String?
  coverImage     String?
  fileUrl        String?
  targetAge      String?
  ageGroup       String?
  category       String?
  summary        String?
  features       String?
  targetAudience String?
  bookSize       String?
  pageCount      Int?
  seriesParts    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  currency       String          @default("BHD")
  isFree         Boolean         @default(false)
  isDeleted      Boolean         @default(false)
  price          Decimal?
  orders         BookOrder[]
  purchases      PurchasedBook[]
  images         BookImage[]

  @@index([category])
  @@index([ageGroup])
  @@index([isFree])
  @@index([isDeleted])
  @@index([uploadedAt])
}

model BookImage {
  id        String   @id @default(cuid())
  bookId    String
  imageUrl  String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId, sortOrder])
}

model PurchasedBook {
  id            String   @id @default(cuid())
  customerId    String
  bookId        String
  price         Decimal
  currency      String
  purchasedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  source        String   @default("PAYMENT")
  status        String   @default("COMPLETED")
  transactionId String?
  orderId       String?  @unique

  customer Customer   @relation(fields: [customerId], references: [id])
  book     Book       @relation(fields: [bookId], references: [id])
  order    BookOrder? @relation(fields: [orderId], references: [id])

  @@unique([customerId, bookId])
  @@index([customerId, status])
  @@index([bookId])
  @@index([transactionId])
}

model BookOrder {
  id          String    @id @default(cuid())
  orderNo     String    @unique
  customerId  String
  bookId      String
  amount      Decimal
  currency    String
  status      String    @default("PENDING")
  provider    String    @default("TAP")
  tapChargeId String?   @unique
  paidAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id])
  book     Book           @relation(fields: [bookId], references: [id])
  purchase PurchasedBook?

  @@index([customerId, bookId])
  @@index([bookId])
  @@index([status])
  @@unique([customerId, bookId], where: raw("(status = 'PENDING')"), name: "BookOrder_pending_customer_book_key")
}

model Website {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  image          String?
  gallery        String[] @default([])
  summary        String?
  description    String?
  system         String?
  details        String?
  features       String?
  targetAudience String?
  responsive     String?
  age            String?
  gameType       String?
  price          Decimal  @db.Decimal(12, 3)
  currency       String
  category       String?
  websiteUrl     String
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  purchases      WebsitePurchase[]
  video          WebsiteVideo?
}

model WebsiteVideo {
  id        String   @id @default(uuid())
  websiteId String   @unique
  videoPath String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
}

model WebsitePurchase {
  id            String   @id @default(cuid())
  customerId    String
  websiteId     String
  price         Decimal  @db.Decimal(12, 3)
  currency      String
  status        String   @default("PENDING")
  transactionId String?
  purchasedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id])
  website  Website  @relation(fields: [websiteId], references: [id])

  @@unique([customerId, websiteId])
  @@index([customerId, status])
  @@index([websiteId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PageVisit {
  id        String   @id @default(cuid())
  path      String
  userAgent String?
  createdAt DateTime @default(now())
}

model RateLimitCounter {
  id          String   @id
  key         String   @unique
  windowStart DateTime
  count       Int      @default(0)
  resetAt     DateTime
  updatedAt   DateTime @updatedAt
}
